# Kafka Settings (Upstash Kafka or Confluent Cloud)
KAFKA_BOOTSTRAP_SERVERS=your-cluster-endpoint.upstash.io:9092
KAFKA_SASL_USERNAME=your-kafka-username
KAFKA_SASL_PASSWORD=your-kafka-password
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_TOPIC_ORDERS=ecommerce.orders
KAFKA_CONSUMER_GROUP=byteflow-ingestion-workers

# Cloud Data Warehouse Settings (MotherDuck or Supabase PostgreSQL)
MOTHERDUCK_TOKEN=your-motherduck-token-here
MOTHERDUCK_DATABASE=byteflow_prod
POSTGRES_HOST=db.example.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_SCHEMA=raw_staging

# Airflow Settings
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor
